# 复制为 .env 后修改。.env 包含数据库口令，禁止提交到版本库。
POSTGRES_USER=xiwei
# 必须修改为强密码；仅使用字母、数字和 . _ ~ -，避免 URL 编码问题
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=xiwei

# Web 入口端口（nginx）
WEB_PORT=8088

# 通过 HTTPS 对外服务时设为 true，避免会话 Cookie 明文传输
COOKIE_SECURE=false

# 额外允许的跨域来源，逗号分隔。同源部署（nginx 代理 /api）可留空。
ALLOWED_ORIGINS=

# 是否开放访客自助注册，默认关闭
ALLOW_REGISTRATION=false

# 登录会话有效期（小时）
SESSION_TTL_HOURS=168
